{
  "name": "page-heatmap",
  "version": "2.0.0",
  "description": "Framework-independent, viewport-based element heatmap",
  "type": "module",
  "license": "MIT",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": { ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" } },
  "files": ["dist"],
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -p tsconfig.build.json && vite build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:browser": "node tests/browser.mjs",
    "check": "npm run lint && npm run typecheck && npm run test && npm run build && npm run test:browser"
  },
  "dependencies": { "simpleheat": "1.0.0" },
  "devDependencies": {
    "@types/node": "26.6.5",
    "eslint": "10.13.0",
    "playwright-core": "1.64.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1",
    "vite": "6.3.5",
    "vitest": "3.2.4"
  }
}
